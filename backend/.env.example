# ---------- Server ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin

# ---------- Security ----------
# Any long random string, at least 16 characters
JWT_SECRET=change-this-jwt-secret-to-a-long-random-value
# 15m - 60m
JWT_EXPIRES_IN=45m
# 64 hex characters = 32 bytes for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Separate 64-hex key used only for the passport blind index (HMAC-SHA256)
PASSPORT_HASH_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
BCRYPT_ROUNDS=12

# ---------- CORS / cookies / uploads ----------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
# Empty = host-only cookie. For admin.example.com + api.example.com use .example.com.
COOKIE_DOMAIN=
# lax is enough for sibling subdomains. Use none only for different registrable domains.
COOKIE_SAME_SITE=lax
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_IMAGES_PER_MEMBER=20

# ---------- Default admin (used by npm run db:seed) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Default Administrator
